{
  "name": "dsh-cnki-helper",
  "version": "1.1.0",
  "description": "在 DSH 会话里检索知网并下载 PDF。复用内置浏览器的登录态，实测零验证码。",
  "keywords": [
    "dsh-plugin",
    "cnki",
    "知网",
    "pdf",
    "文献"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BigFier/dsh-cnki-helper.git"
  },
  "homepage": "https://github.com/BigFier/dsh-cnki-helper#readme",
  "bugs": {
    "url": "https://github.com/BigFier/dsh-cnki-helper/issues"
  }
}
